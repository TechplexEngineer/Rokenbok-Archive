[
  {{- range $index, $page := where .Site.RegularPages "Draft" false -}}
    {{- if $index }},{{ end -}}
    {
      "title": {{ $page.Title | jsonify }},
      "url": {{ $page.RelPermalink | jsonify }},
      "summary": {{ $page.Summary | plainify | jsonify }},
      "content": {{ $page.Plain | jsonify }}
    }
  {{- end -}}
]
